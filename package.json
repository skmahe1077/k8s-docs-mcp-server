{
  "name": "k8s-docs-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing Kubernetes documentation for doc search and CKA/CKAD/CKS certification prep",
  "type": "module",
  "private": true,
  "bin": {
    "k8s-docs-mcp-server": "dist/index.js"
  },
  "scripts": {
    "sync": "tsx scripts/sync-docs.ts",
    "index": "tsx scripts/build-index.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.3.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
